# The backend origin. No trailing slash, and no /api/v1 — the client adds it.
# The app asserts this at startup and refuses to run without it.
NEXT_PUBLIC_API_BASE_URL=https://race-os-backend.onrender.com

# Stripe test-mode publishable key, for the checkout step. Optional: without it
# every screen but checkout still works.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
