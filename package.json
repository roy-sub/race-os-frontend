{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "api:pull": "node scripts/pull-openapi.mjs",
    "api:types": "openapi-typescript openapi/openapi.json -o lib/api/schema.d.ts",
    "api:sync": "npm run api:pull && npm run api:types",
    "seo:races": "node scripts/pull-races.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "deploy": "next build && wrangler pages deploy out --project-name=${CF_PAGES_PROJECT:-raceos}",
    "assets:webp": "node scripts/png-to-webp.mjs",
    "prebuild": "node scripts/asset-manifest.mjs && node scripts/security-headers.mjs",
    "postbuild": "node scripts/seo-check.mjs"
  },
  "dependencies": {
    "@stripe/stripe-js": "^5.10.0",
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.3",
    "openapi-fetch": "^0.13.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.160.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
